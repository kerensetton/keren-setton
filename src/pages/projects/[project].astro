---
import type { MarkdownInstance } from 'astro';
import Base from '../../layouts/Base.astro';
import settings from '../../content/artist2-settings/main.json';

type ProjectImage = { src: string; alt: string; caption?: string };

type ProjectFrontmatter = {
  title: string;
  year: string;
  medium: string;
  shortDesc: string;
  coverImage: string;
  images: ProjectImage[];
};

type Project = ProjectFrontmatter & {
  id: string;
  Content: MarkdownInstance<ProjectFrontmatter>['Content'];
};

export async function getStaticPaths() {
  const projectFiles: MarkdownInstance<ProjectFrontmatter>[] = await Astro.glob('../../content/artist2-projects/*.md');
  const allProjects: Project[] = projectFiles
    .map((f) => ({
      id: f.file.split('/').pop()!.replace('.md', ''),
      Content: f.Content,
      ...f.frontmatter,
    }))
    .sort((a, b) => Number(b.year) - Number(a.year));

  return allProjects.map((project, index) => ({
    params: { project: project.id },
    props: {
      project,
      prevProject: index > 0 ? allProjects[index - 1] : null,
      nextProject: index < allProjects.length - 1 ? allProjects[index + 1] : null,
    },
  }));
}

const { project, prevProject, nextProject } = Astro.props;
const { Content } = project;

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/projects/' },
  { label: 'About', href: '/about/' },
];
---

<Base
  title={`${project.title} — ${settings.artistName}`}
  description={project.shortDesc}
  navLogo={settings.artistName}
  navLinks={navLinks}
  navVariant="light"
  navCtaText=""
  hideFooter
>
  <!-- Project header -->
  <section class="project-header">
    <div class="container">
      <p class="project-header__breadcrumb">
        <a href="/">{settings.artistName}</a>
        <span aria-hidden="true"> / </span>
        <a href="/projects/">Work</a>
        <span aria-hidden="true"> / </span>
        {project.title}
      </p>
      <div class="project-header__inner">
        <div class="project-header__title-group">
          <h1 class="project-header__title">{project.title}</h1>
        </div>
        <dl class="project-header__meta">
          <div class="project-meta-item">
            <dt>Year</dt>
            <dd>{project.year}</dd>
          </div>
          <div class="project-meta-item">
            <dt>Medium</dt>
            <dd>{project.medium}</dd>
          </div>
          <div class="project-meta-item">
            <dt>Images</dt>
            <dd>{project.images.length}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Description -->
  <section class="project-description-section">
    <div class="container prose">
      <Content />
    </div>
  </section>

  <!-- Image grid -->
  <section class="project-images-section">
    <div class="container">
      <div class="project-images__grid">
        {project.images.map((img, i) => (
          <figure class={`project-image project-image--${i % 5}`}>
            <div class="project-image__wrap">
              <img
                src={img.src}
                alt={img.alt}
                loading={i < 2 ? 'eager' : 'lazy'}
                class="project-image__img"
              />
            </div>
            {img.caption && (
              <figcaption class="project-image__caption">{img.caption}</figcaption>
            )}
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Project navigation -->
  <nav class="project-nav" aria-label="Next and previous projects">
    <div class="container">
      <div class="project-nav__inner">
        <div class="project-nav__prev">
          {prevProject && (
            <a href={`/projects/${prevProject.id}/`} class="project-nav__link project-nav__link--prev">
              <span class="project-nav__dir">← Previous</span>
              <span class="project-nav__name">{prevProject.title}</span>
            </a>
          )}
        </div>
        <a href="/projects/" class="project-nav__all">All Projects</a>
        <div class="project-nav__next">
          {nextProject && (
            <a href={`/projects/${nextProject.id}/`} class="project-nav__link project-nav__link--next">
              <span class="project-nav__dir">Next →</span>
              <span class="project-nav__name">{nextProject.title}</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </nav>
</Base>

<style>
  /* ── Project header ──────────────────────────── */
  .project-header {
    background: #f7f4f0;
    padding-block: 3rem 2.5rem;
    border-bottom: 1px solid #e2ddd8;
  }

  .project-header__breadcrumb {
    font-size: 0.8rem;
    color: #8a7e76;
    margin-bottom: 1.5rem;
    max-width: none;
  }

  .project-header__breadcrumb a {
    color: #8a7e76;
    transition: color 0.2s ease;
  }

  .project-header__breadcrumb a:hover {
    color: #c44b2c;
  }

  .project-header__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .project-header__title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 4rem);
    color: #1a1614;
    line-height: 1;
    margin: 0;
  }

  .project-header__meta {
    display: flex;
    gap: 2.5rem;
    flex-shrink: 0;
  }

  .project-meta-item dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8a7e76;
    margin-bottom: 0.25rem;
  }

  .project-meta-item dd {
    font-size: 0.9rem;
    font-weight: 500;
    color: #1a1614;
    margin: 0;
  }

  /* ── Description ─────────────────────────────── */
  .project-description-section {
    background: #f7f4f0;
    padding-block: 4rem;
  }

  .prose :global(p) {
    font-size: 1rem;
    line-height: 1.85;
    color: #3a3330;
    max-width: 100%;
    margin-bottom: 1.25rem;
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  /* ── Image grid ──────────────────────────────── */
  .project-images-section {
    background: #f7f4f0;
    padding-block: 0 5rem;
  }

  .project-images__grid {
    columns: 2;
    column-gap: 1.25rem;
  }

  .project-image {
    break-inside: avoid;
    margin-bottom: 1.25rem;
  }

  .project-image__wrap {
    overflow: hidden;
    border-radius: 4px;
    background: #ede9e4;
  }

  .project-image__img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s ease;
  }

  .project-image:hover .project-image__img {
    transform: scale(1.03);
  }

  .project-image__caption {
    font-size: 0.75rem;
    color: #8a7e76;
    margin-top: 0.5rem;
    line-height: 1.4;
  }

  /* ── Project nav ─────────────────────────────── */
  .project-nav {
    background: #ede9e4;
    border-top: 1px solid #e2ddd8;
    padding-block: 2.5rem;
  }

  .project-nav__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
  }

  .project-nav__all {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8a7e76;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .project-nav__all:hover {
    color: #c44b2c;
  }

  .project-nav__prev {
    justify-self: start;
  }

  .project-nav__next {
    justify-self: end;
  }

  .project-nav__link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
  }

  .project-nav__link--prev {
    align-items: flex-start;
  }

  .project-nav__link--next {
    align-items: flex-end;
  }

  .project-nav__dir {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8a7e76;
    transition: color 0.2s ease;
  }

  .project-nav__name {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: #1a1614;
    transition: color 0.2s ease;
  }

  .project-nav__link:hover .project-nav__dir,
  .project-nav__link:hover .project-nav__name {
    color: #c44b2c;
  }

  /* ── Responsive ──────────────────────────────── */

  @media (max-width: 768px) {
    .project-header__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .project-header__meta {
      gap: 1.5rem;
    }


    .project-images__grid {
      columns: 1;
    }

    .project-nav__inner {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
    }

    .project-nav__all {
      grid-column: 1 / -1;
      justify-self: center;
      order: -1;
      margin-bottom: 0.5rem;
    }

    .project-nav__prev {
      justify-self: start;
    }

    .project-nav__next {
      justify-self: end;
    }
  }
</style>
