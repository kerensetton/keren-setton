---
import Base from '../layouts/Base.astro';
import settings from '../content/artist2-settings/main.json';

const { artistName, discipline, location, heroImage, heroCtaText, socials } = settings;

const [firstName, ...lastNameParts] = artistName.split(' ');
const lastName = lastNameParts.join(' ');

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/projects/' },
  { label: 'About', href: '/about/' },
];
---

<Base
  title={`${artistName} | ${discipline}`}
  description={`${artistName} is a ${location}-based ${discipline.toLowerCase()} working with long-exposure photography, found objects, and site-specific installation.`}
  navLogo={artistName}
  navLinks={navLinks}
  navVariant="light"
  navCtaText=""
  hideFooter
>
  <section class="hero">
    <div class="hero__image-wrap">
      <img
        src={heroImage}
        alt={`${artistName} — featured work`}
        width="1800"
        height="1100"
        class="hero__image"
      />
      <div class="hero__overlay"></div>
    </div>
    <div class="hero__content">
      <div class="hero__top">
        <span class="hero__discipline">{discipline}</span>
        <span class="hero__location">{location}</span>
      </div>
      <div class="hero__bottom">
        <div class="hero__name-group">
          <h1 class="hero__name">{firstName}<br />{lastName}</h1>
        </div>
        <div class="hero__bottom-right">
          <a href="/projects/" class="hero__cta">{heroCtaText}</a>
          <nav class="hero__socials" aria-label="Social links">
            {socials.map((s) => (
              <a href={s.href} class="hero__social">{s.label}</a>
            ))}
          </nav>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    height: calc(100svh - 4rem);
    min-height: 560px;
    display: flex;
    flex-direction: column;
  }

  .hero__image-wrap {
    position: absolute;
    inset: 0;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(26, 22, 20, 0.35) 0%,
      rgba(26, 22, 20, 0.1) 40%,
      rgba(26, 22, 20, 0.6) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2.5rem 0 2.5rem;
    max-width: var(--max-width);
    width: 100%;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .hero__top {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .hero__discipline,
  .hero__location {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(247, 244, 240, 0.8);
  }

  .hero__discipline::after {
    content: '·';
    margin-left: 1.5rem;
  }

  .hero__bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .hero__name {
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 10vw, 8rem);
    font-weight: 700;
    color: #f7f4f0;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .hero__bottom-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.5rem;
  }

  .hero__socials {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .hero__social {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: rgba(247, 244, 240, 0.7);
    border-bottom: 1px solid rgba(247, 244, 240, 0.3);
    padding-bottom: 0.1em;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .hero__social:hover {
    color: #f7f4f0;
    border-color: #f7f4f0;
  }

  .hero__cta {
    font-size: 0.9rem;
    font-weight: 600;
    color: #f7f4f0;
    letter-spacing: 0.03em;
    padding: 0.6rem 1.4rem;
    border: 1px solid rgba(247, 244, 240, 0.5);
    border-radius: 2rem;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .hero__cta:hover {
    background-color: rgba(247, 244, 240, 0.15);
    border-color: #f7f4f0;
  }

  @media (max-width: 768px) {
    .hero__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .hero__bottom-right {
      align-items: flex-start;
    }

    .hero__socials {
      justify-content: flex-start;
    }
  }
</style>
